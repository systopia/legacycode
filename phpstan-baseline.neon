parameters:
	ignoreErrors:
		-
			message: '#^Call to an undefined method CRM_Core_Form\:\:addDateRange\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: CRM/Legacycode/Date.php

		-
			message: '#^Method CRM_Legacycode_Date\:\:addDateRangeToForm\(\) has parameter \$attributes with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: CRM/Legacycode/Date.php

		-
			message: '#^Method CRM_Legacycode_Date\:\:addDateRangeToForm\(\) has parameter \$selector with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: CRM/Legacycode/Date.php

		-
			message: '#^Method CRM_Legacycode_Date\:\:buildDateRange\(\) has parameter \$attributes with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: CRM/Legacycode/Date.php

		-
			message: '#^Method CRM_Legacycode_Date\:\:buildDateRange\(\) has parameter \$operators with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: CRM/Legacycode/Date.php

		-
			message: '#^Method CRM_Legacycode_Date\:\:returnDateRangeSelector\(\) has parameter \$operators with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: CRM/Legacycode/Date.php

		-
			message: '#^Method CRM_Legacycode_Date\:\:returnDateRangeSelector\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: CRM/Legacycode/Date.php

		-
			message: '#^Parameter \#10 \$displayTime of static method CRM_Legacycode_Date\:\:returnDateRangeSelector\(\) expects bool, bool\|string given\.$#'
			identifier: argument.type
			count: 1
			path: CRM/Legacycode/Date.php

		-
			message: '#^Parameter \#9 \$displayTime of static method CRM_Legacycode_Date\:\:addDateRangeToForm\(\) expects bool, bool\|string given\.$#'
			identifier: argument.type
			count: 1
			path: CRM/Legacycode/Date.php

		-
			message: '#^Cannot cast array\|int to string\.$#'
			identifier: cast.string
			count: 1
			path: CRM/Legacycode/OptionGroup.php

		-
			message: '#^Method CRM_Legacycode_OptionGroup\:\:getLabel\(\) should return string\|null but returns array\|int\.$#'
			identifier: return.type
			count: 1
			path: CRM/Legacycode/OptionGroup.php
